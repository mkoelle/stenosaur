package ui

// layout is the base HTML shell for all admin UI pages. (ADR-007, US-C01)
// It imports vendored HTMX, Alpine.js, and the generated Tailwind CSS.
// No CDN links — all assets are served from /static/. (ADR-007)

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — Stenosaur</title>
			<!-- Tailwind CSS (generated by Tailwind CLI; embedded via //go:embed) -->
			<link rel="stylesheet" href="/static/tw.css"/>
			<!-- HTMX (vendored; no CDN) -->
			<script src="/static/htmx.min.js" defer></script>
			<!-- HTMX WebSocket extension for /logs tail -->
			<script src="/static/htmx-ext-ws.min.js" defer></script>
			<!-- Alpine.js (vendored; no CDN) -->
			<script src="/static/alpine.min.js" defer></script>
		</head>
		<body class="bg-gray-950 text-gray-100 min-h-screen font-mono">
			<header class="border-b border-gray-800 px-6 py-4 flex items-center gap-3">
				<span class="text-green-400 font-bold tracking-widest text-sm">STENOSAUR</span>
				<span class="text-gray-600 text-xs">Zoom Bot Admin</span>
			</header>
			<main class="px-6 py-6">
				{ children... }
			</main>
		</body>
	</html>
}
