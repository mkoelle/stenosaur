# Stenosaur configuration — copy to .env and fill in values
# .env is excluded from version control (.gitignore)
# See docs/adr/ADR-003-docker-deployment.md for full variable documentation

# ── Required ─────────────────────────────────────────────────────────────────

# Full Zoom meeting URL to join (e.g. https://zoom.us/j/1234567890?pwd=...)
MEETING_URL=

# Name shown in the Zoom participant list
BOT_DISPLAY_NAME=Stenosaur

# Bearer token for the web admin UI and API — minimum 16 characters
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# Host port mapped to the admin HTTP server (LAN-accessible)
ADMIN_PORT=8080

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Container path for media source files (matches docker-compose volume mount)
MEDIA_DIR=/app/media

# Audio ring buffer depth in frames (ADR-002: 200 frames = 2 seconds)
AUDIO_BUFFER_FRAMES=200

# Video FIFO queue depth in frames (ADR-002: 10 frames ≈ 333 ms, ~27 MB)
VIDEO_BUFFER_FRAMES=10

# ── Secret variables (never logged) ──────────────────────────────────────────

# Zoom meeting password — used only in the join flow, never stored in state
# Include in MEETING_URL query param OR set here; do not do both
MEETING_PASSWORD=
